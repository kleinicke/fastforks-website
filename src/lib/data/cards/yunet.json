{"family": "yunet", "task": "pose", "name": "YuNet", "plain": "YuNet (Wu, Peng, Yu, Shenzhen University; libfacedetection.train): a tiny face detector (YuNet-n 75 k, YuNet-s 55 k parameters, OpenCV's FaceDetectorYN) that finds faces with a box and five landmarks. BSD-3-Clause code and weights.", "summary": "YuNet (Wu et al., Machine Intelligence Research 2023): a 75k-parameter anchor-free face detector with five facial landmarks, the network behind libfacedetection and OpenCV's `FaceDetectorYN` (OpenCV Zoo `face_detection_yunet`). Depthwise-separable backbone, a tiny top-down FPN and per-cell class / objectness / box / landmark heads on the stride 8 / 16 / 32 maps. Takes the whole image at its own size (padded to multiples of 32, as upstream's WIDER FACE evaluation); vendored from libfacedetection.train's PyTorch code. The portable `module()` maps the image to the raw head maps (decoding and NMS stay outside).", "tier": "stable", "upstream": "https://github.com/ShiqiYu/libfacedetection.train", "upstream_commit": "dca340aa082c71081a68d17db8e58b33a58a914b", "original_is": null, "papers": [{"title": "YuNet: A Tiny Millisecond-level Face Detector", "url": "https://doi.org/10.1007/s11633-023-1423-y", "date": "2023-05-15", "venue": "Machine Intelligence Research 2023", "variants": []}], "official": [{"repo": "https://github.com/opencv/opencv_zoo/tree/main/models/face_detection_yunet", "framework": "ONNX (OpenCV DNN)", "reason": "The OpenCV Zoo ships the same network as ONNX for `cv2.FaceDetectorYN`; the PyTorch weights and the WIDER FACE evaluation are libfacedetection.train's.", "variants": []}], "modes": ["portable", "kernels"], "portable_dtype": "float16", "kernels_dtype": "float16", "kernel_libs": ["box_nms", "cudnn_hacc", "fvm_conv", "fvm_extra", "fvm_mb", "fvm_r3"], "mps_kernel_libs": [], "mps_dtypes": ["float32", "float16"], "no_kernels_reason": "", "no_original_reason": "", "options": [{"name": "score_threshold", "default": 0.6, "bounds": "0.0 to 1.0", "effect": "output"}], "outputs": [{"name": "keypoints", "extra": false}, {"name": "keypoint_scores", "extra": false}, {"name": "boxes", "extra": false}, {"name": "scores", "extra": false}], "output_info": {"label_set": "face-5"}, "licence_files": ["LICENSE"], "licence_notes": [], "limitations": ["module() exports the raw per-level head maps; decoding and NMS remain outside the exported graph.", "No per-landmark confidence: keypoint_scores repeats the face score.", "The image is not resized: faces much smaller than about 10 px are missed; large photos cost time in proportion to their pixels."], "task_io": "Input: one RGB image and a box per person. Output: keypoints with confidence scores for every person.", "install": {"extras": [], "noncommercial_weights": []}, "variants": [{"id": "yunet-n", "released": "0.2.0", "added_in": "0.2.0", "ref": "yunet-n@1", "name": "yunet-n", "setting": "", "default_tag": false, "params": {}, "licence": {"code": "BSD-3-Clause", "code_class": "permissive", "weights": "BSD-3-Clause", "weights_assumed": false, "evidence": "https://github.com/ShiqiYu/libfacedetection.train/blob/dca340aa082c71081a68d17db8e58b33a58a914b/LICENSE", "training_data": [{"id": "wider-face", "name": "WIDER FACE (32k images, 394k labelled faces)", "licence": "LicenseRef-research-only", "commercial": "no", "url": "https://web.archive.org/web/20261014221817/http://shuoyang1213.me/WIDERFACE/"}], "training_note": "WIDER FACE train with the SCRFD five-landmark annotations (labelv2), from scratch", "commercial": "yes", "reasons": [], "notes": ["data: wider-face (non-commercial)"]}, "weights": [{"name": "yunet_n.pth", "sha256": "9c7c9e14a4d60e57491d77e4d8b0d451bd834f300e05c0dea7fd1f6533817b06", "size": 747497, "url": "https://github.com/ShiqiYu/libfacedetection.train/raw/dca340aa082c71081a68d17db8e58b33a58a914b/weights/yunet_n.pth", "host": "GitHub", "member": null, "archive_size": null, "mirror": null}], "input_size": "any H x W >= 32, padded to a multiple of 32", "tested_max": {"siz