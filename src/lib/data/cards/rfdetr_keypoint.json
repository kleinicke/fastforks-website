{"family": "rfdetr_keypoint", "task": "pose", "name": "RF-DETR Keypoint", "plain": "Roboflow RF-DETR Keypoint Preview: predicts people and their 17 COCO joints from a whole image using a DINOv2 backbone and transformer decoder. Apache-2.0 code and preview weights.", "summary": "Roboflow RF-DETR Keypoint Preview: a DINOv2-small backbone with windowed attention and a deformable transformer decoder that predicts people and 17 COCO joints directly from the whole image. The 40.7M-parameter Apache-2.0 preview uses 576 x 576 square inputs and conditional keypoint queries. Person confidence includes the upstream localization-uncertainty fusion; joint confidence is findability. No person detector, boxes or NMS are required.", "tier": "stable", "upstream": "https://github.com/roboflow/rf-detr", "upstream_commit": "5b22dfc0940697ce1abdfa681a5f7392b3eddbfb", "original_is": null, "papers": [{"title": "RF-DETR: Neural Architecture Search for Real-Time Detection Transformers", "url": "https://arxiv.org/abs/2511.09554", "date": "2025-11-12", "venue": "ICLR 2026", "variants": []}], "official": [], "modes": ["portable", "kernels"], "portable_dtype": "float16", "kernels_dtype": "float16", "kernel_libs": ["rfdetr_input", "fastbb"], "mps_kernel_libs": [], "mps_dtypes": ["float32", "float16"], "no_kernels_reason": "", "no_original_reason": "", "options": [{"name": "score_threshold", "default": 0.5, "bounds": "0.0 to 1.0", "effect": "output"}], "outputs": [{"name": "keypoints", "extra": false}, {"name": "keypoint_scores", "extra": false}, {"name": "boxes", "extra": false}, {"name": "scores", "extra": false}], "output_info": {"label_set": "coco-keypoints-17"}, "licence_files": ["LICENSE"], "licence_notes": [], "limitations": ["Requires the optional transformers and torchvision libraries.", "This is the Apache-2.0 Keypoint Preview checkpoint; restricted RF-DETR Plus detection variants are not included.", "module() exports raw boxes, class logits and keypoint predictions; confidence fusion a