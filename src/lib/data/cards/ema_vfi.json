{"family": "ema_vfi", "task": "interpolation", "name": "EMA-VFI", "plain": "EMA-VFI (Zhang et al., CVPR 2023; large and small, for the middle frame or any time): makes the frame between two video frames from motion and appearance features that inter-frame attention extracts together, for slow motion and higher frame rates. Apache-2.0 code and weights.", "summary": "EMA-VFI (Zhang et al., CVPR 2023): video frame interpolation with inter-frame attention. A hybrid CNN and Transformer backbone; in its two window-attention stages (1/16 and 1/32 of the image) each frame attends to the other, and the attention map gives both the appearance features and motion features (the attention-weighted pixel offsets). Two heads estimate the flow to both frames and a fusion mask, a U-Net refines the blend of both warped frames. `ema-vfi` and `ema-vfi-small` are trained for the middle frame, `ema-vfi-t` and `ema-vfi-small-t` for any time in [0, 1].", "tier": "experimental", "upstream": "https://github.com/MCG-NJU/EMA-VFI", "upstream_commit": "75b6f6a889e695df875e103374040d47a4cfac7c", "original_is": null, "papers": [{"title": "Extracting Motion and Appearance via Inter-Frame Attention for Efficient Video Frame Interpolation", "url": "https://arxiv.org/abs/2303.00440", "date": "2023-03-01", "venue": "CVPR 2023", "variants": []}], "official": [], "modes": ["portable", "kernels"], "portable_dtype": "float16", "kernels_dtype": "float16", "kernel_libs": ["cudnn_hacc"], "mps_kernel_libs": [], "mps_dtypes": ["float32"], "no_kernels_reason": "", "options": [{"name": "cuda_graphs", "default": true, "bounds": "", "effect": "speed"}, {"name": "tta", "default": false, "bounds": "", "effect": "output"}], "outputs": [{"name": "frame", "extra": false}], "output_info": {}, "licence_files": ["LICENSE"], "licence_notes": [], "limitations": [], "task_io": "Input: two RGB images (consecutive frames). Output: the frame between them at `timestep` (0.5 by default; 0 = the first, 1 = the second), RGB in [0, 1].", "install": {"extras": [], "noncommercial_weights": []}, "variants": [{"id": "ema-vfi", "released": null, "added_in": "0.2.0", "ref": "ema-vfi@1", "name": "ema-vfi", "setting": "", "default_tag": false, "params": {}, "licence": {"code": "Apache-2.0", "code_class": "permissive", "weights": "Apache-2.0", "weights_assumed": false, "evidence": "https://github.com/MCG-NJU/EMA-VFI/blob/75b6f6a889e695df875e103374040d47a4cfac7c/LICENSE ; https://github.com/MCG-NJU/EMA-VFI/blob/75b6f6a889e695df875e103374040d47a4cfac7c/README.md (checkpoints: https://drive.google.com/drive/folders/16jUa3HkQ85Z5lb5gce1yoaWkP-rdCd0o)", "training_data": [{"id": "vimeo90k", "name": "Vimeo-90K (septuplets / triplets for frame interpolation)", "licence": "not stated", "commercial": "unclear", "url": "http://toflow.csail.mit.edu/"}], "training_note": "README: the fixed-time models train on Vimeo-90K triplets (train.py); the arbitrary-time `_t` models are evaluated on 4x / 8x benchmarks, their training data is not stated (the paper: Vimeo-90K septuplets).", "commercial": "yes", "reasons": [], "notes": ["data: vimeo90k (unclear)"]}, "weights": [{"name": "ema-vfi-ours.pkl", "sha256": "f9085bb32d8b2eaa70eb1df08cc25bc7e973c50a74d74fb593ebe0d5e100a11f", "size": 263760209, "url": "https://drive.usercontent.google.com/download?id=1XCNoyhA1RX3m8W-XJK8H8inH47l36kxP&export=download&confirm=t", "host": "Google Drive", "member": null, "archive_size": null, "mirror": null}], "input_size": "any H x W >= 32, padded to a multiple of 32", "tested_max": {"size": "1988x2880", "alloc_mib": 7625, "reserved_mib": 9344}, "speed": {"standard": "1080x1920", "inputs": [{"input": "480x854", "scene": "synthetic", "standard": false, "modes": {"original16": {"ms": 69.21, "ms_min": 66.2, "runs": 5, "peak_alloc_mb": 1122, "peak_reserved_mb": 1214, "load_s": 1.19, "first_call_s": 0.619, "scene": "synthetic (fastforks bench)", "date": "2026-11-14", "torch": "2.14.1+cu130", "protocol": "median of 5 after 3 warm-up, uint8 CUDA inpu