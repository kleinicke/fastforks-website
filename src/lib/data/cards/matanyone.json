{"family": "matanyone", "task": "matting", "name": "MatAnyone", "plain": "MatAnyone (Yang et al., S-Lab NTU, CVPR 2025): video matting of one object: from a mask of the object in the first frame it tracks the object and outputs a soft alpha matte (hair, motion blur) for every frame, with a memory of earlier frames. Non-commercial code and weights (S-Lab License 1.0).", "summary": "MatAnyone (Yang et al., NTU S-Lab, CVPR 2025): video matting of one object from a mask on the first frame. A Cutie-style memory network (ResNet-50 frame encoder, ResNet-18 mask encoder, object transformer) reads the alpha and features of earlier frames with consistent memory propagation: each region updates its memory only where the alpha changes. Takes a video and the first-frame mask (`video`); a single image is a one-frame video.", "tier": "experimental", "upstream": "https://github.com/pq-yang/MatAnyone", "upstream_commit": "e5ddc534c1fff9bb9e54cf476095d29071b7cb4f", "original_is": null, "papers": [{"title": "MatAnyone: Stable Video Matting with Consistent Memory Propagation", "url": "https://arxiv.org/abs/2501.14677", "date": "2025-01-24", "venue": "CVPR 2025", "variants": []}], "official": [], "modes": ["portable", "kernels"], "portable_dtype": "float16", "kernels_dtype": "float16", "kernel_libs": ["image_normalize"], "mps_kernel_libs": [], "mps_dtypes": ["float32", "float16"], "no_kernels_reason": "", "no_original_reason": "", "options": [{"name": "warmup", "default": 10, "bounds": ">= 0", "effect": "output"}, {"name": "dilate", "default": 10, "bounds": ">= 0", "effect": "output"}, {"name": "erode", "default": 10, "bounds": ">= 0", "effect": "output"}], "outputs": [{"name": "alpha", "extra": false}], "output_info": {}, "licence_files": ["LICENSE"], "licence_notes": [], "limitations": ["`torch.compile` compiles the image encoder, mask encoder and tensor decoder. It runs the recurrent memory and video loop eagerly. Each new input shape has a compilation cost."], "task_io": "Input: one RGB image (trimap-guided models also a trimap: background / unknown / foreground). Output: an alpha matte `[H, W]` in [0, 1] at the input size: 1 = foreground (background removal, dichotomous / salient object segmentation).", "install": {"extras": ["nc"], "noncommercial_weights": ["matanyone"]}, "variants": [{"id": "matanyone", "released": "0.2.0", "added_in": "0.2.0", "ref": "matanyone@1", "name": "matanyone", "setting": "", "default_tag": false, "params": {}, "licence": {"code": "LicenseRef-noncommercial", "code_class": "noncommercial", "weights": "LicenseRef-noncommercial", "weights_assumed": false, "evidence": "https://github.com/pq-yang/MatAnyone/blob/e5ddc534c1fff9bb9e54cf476095d29071b7cb4f/LICENSE ; https://github.com/pq-yang/MatAnyone/blob/e5ddc534c1fff9bb9e54cf476095d29071b7cb4f/README.md (weights: https://github.com/pq-yang/MatAnyone/releases/tag/v1.0.0)", "training_data": [{"id": "vm800", "name": "VM800 (MatAnyone video matting foregrounds)", "licence": "not stated", "commercial": "no", "url": "https://github.com/pq-yang/MatAnyone/blob/e5ddc534c1fff9bb9e54cf476095d29071b7cb4f/doc/TRAIN.md"}, {"id": "composition-1k", "name": "Composition-1k (Adobe Deep Image Matting)", "licence": "LicenseRef-research-only", "commercial": "no", "url": "https://sites.google.com/view/deepimagematting"}, {"id": "distinctions-646", "name": "Distinctions-646 (image matting)", "licence": "not stated", "commercial": "unclear", "url": "https://wukaoliu.github.io/HAttMatting/"}, {"id": "bg20k", "name": "BG-20k (background images)", "licence": "MIT", "commercial": "yes", "url": "https://jizhizili.github.io/files/gfm_datasets_agreements/BG-20k_Dataset_Release_Agreement.pdf"}, {"id": "dvm-background", "name": "DVM background set (video backgrounds)", "licence": "not stated", "commercial": "unclear", "url": "https://github.com/nowsyn/DVM/blob/c045693867c9397ed3eb635cea7c6f2cba6c02c3/README.md"}, {"id": "coco", "name": "COCO 2017 (train, instance annotations)", "licence": "CC-BY-4.0", "