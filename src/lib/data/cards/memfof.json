{"family": "memfof", "task": "flow", "name": "MEMFOF", "plain": "MEMFOF (MSU Graphics & Media Lab, ICCV 2025): memory-efficient multi-frame optical flow, a RAFT-style network that also looks at the previous frame and runs at full HD. BSD-3-Clause code and weights; some training sets are research-only.", "summary": "MEMFOF (Bargatin et al. 2025): memory-efficient multi-frame optical flow. A RAFT-style network at 1/16 resolution on three frames: a ResNet34 context encoder on all three, a GMA attention over the context, 1024-channel features with an all-pairs correlation pyramid toward the previous and the next frame, a ConvNeXt update block and convex 16x upsampling; it predicts the backward and the forward flow of the middle frame at once. The authors' released weights; the network is ported from msu-video-group/memfof. A pair (image1, image2) runs as upstream's first frame of a clip, the frames (image1, image1, image2), and returns its forward flow. Paper (three frames per prediction, the fine-tuned checkpoints): Spring test 1px 3.289 %, Sintel test EPE 0.963 (clean), KITTI 2015 test Fl-all 2.94 %.", "tier": "experimental", "upstream": "https://github.com/msu-video-group/memfof", "upstream_commit": "a51de9fc59c6fe20ba08e079372c7b583d58a712", "original_is": null, "papers": [{"title": "MEMFOF: High-Resolution Training for Memory-Efficient Multi-Frame Optical Flow Estimation", "url": "https://arxiv.org/abs/2506.23151", "date": "2025-06-29", "venue": "ICCV 2025", "variants": []}], "official": [], "modes": ["portable", "kernels"], "portable_dtype": "float16", "kernels_dtype": "float16", "kernel_libs": ["raft_flow"], "mps_kernel_libs": [], "mps_dtypes": ["float32"], "no_kernels_reason": "", "options": [{"name": "iters", "default": 8, "bounds": ">= 1", "effect": "output"}], "outputs": [{"name": "flow", "extra": false}], "output_info": {}, "licence_files": ["LICENSE", "LICENSE-torchvision"], "licence_notes": [], "limitations": ["Pairs only: the multi-frame input (a previous frame and the feature cache of upstream's video demo) is not exposed; each pair runs as the first frame of a clip."], "task_io": "Input: two RGB images (consecutive frames). Output: per-pixel motion from the first to the second (dx, dy in pixels).", "install": {"extras": [], "noncommercial_weights": []}, "variants": [{"id": "memfof", "released": null, "added_in": "0.2.0", "ref": "memfof@1", "name": "memfof", "setting": "", "default_tag": false, "params": {}, "licence": {"code": "BSD-3-Clause", "code_class": "permissive", "weights": "BSD-3-Clause", "weights_assumed": false, "evidence": "https://huggingface.co/egorchistov/optical-flow-MEMFOF-Tartan-T-TSKH/blob/6c6c9aa3ad64f93aee8efbc2f7a6e4535814ee96/README.md", "training_data": [{"id": "tartanair", "name": "TartanAir", "licence": "CC-BY-4.0", "commercial": "yes", "url": "https://theairlab.org/tartanair-dataset/"}, {"id": "sceneflow", "name": "Freiburg SceneFlow (FlyingThings3D, Driving, Monkaa)", "licence": "LicenseRef-research-only", "commercial": "no", "url": "https://lmb.informatik.uni-freiburg.de/resources/datasets/SceneFlowDatasets.en.html"}, {"id": "sintel-flow", "name": "MPI Sintel optical flow", "licence": "LicenseRef-noncommercial", "commercial": "no", "url": "https://sintel.is.tue.mpg.de/license"}, {"id": "kitti", "name": "KITTI stereo / optical flow 2012 / 2015", "licence": "CC-BY-NC-SA-3.0", "commercial": "no", "url": "https://www.cvlibs.net/datasets/kitti/"}, {"id": "hd1k", "name": "HCI HD1K optical flow benchmark", "licence": "not stated", "commercial": "unclear", "url": "https://hci-benchmark.iwr.uni-heidelberg.de/"}], "training_note": "TartanAir, FlyingThings3D (part of SceneFlow), then a mix of FlyingThings3D, Sintel, KITTI 2015 and HD1K (TSKH), as upstream's config/train/*.json", "commercial": "yes", "reasons": [], "notes": ["data: sceneflow (non-commercial)", "data: sintel-flow (non-commercial)", "data: kitti (non-commercial)", "data: hd1k (unclear)"]}, "weights": [{"name": "MEMFOF-Tartan-T-TSKH.s