{
	"name": "fastforks-website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"check": "svelte-kit sync && vp check && svelte-check --tsconfig ./tsconfig.json",
		"fix": "vp check --fix",
		"sync": "node scripts/sync-data.ts",
		"build:prod": "VITE_SITE_URL=https://fastforks.dev vp build",
		"ship": "pnpm build:prod && wrangler pages deploy build --project-name=fastforks --branch=main --commit-dirty=true"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/node": "^26.6.6",
		"marked": "18.1.3",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
		"vite-plus": "1.5.0",
		"wrangler": "4.125.0"
	},
	"packageManager": "pnpm@10.32.1"
}
